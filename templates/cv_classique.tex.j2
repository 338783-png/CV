\#{ Modele classique : une colonne, sobre, lisible par les ATS. }
\BLOCK{include "_preambule.tex.j2"}
\policeserif
\hypersetup{pdftitle={CV - \VAR{cv.nom}}, pdfauthor={\VAR{cv.nom}}}
\titleformat{\section}{\large\bfseries\color{accent}}{}{0pt}{}[\titlerule]
\titlespacing{\section}{0pt}{10pt}{6pt}

\begin{document}

% ---------- En-tête ----------
\BLOCK{if cv.photo}
\begin{minipage}[c]{0.76\textwidth}\raggedright
\BLOCK{else}
\begin{center}
\BLOCK{endif}
  {\LARGE\bfseries \VAR{cv.nom}}\par
  \BLOCK{if cv.titre}
  \vspace{3pt}{\large\color{accent} \VAR{cv.titre}}\par
  \BLOCK{endif}
  \BLOCK{if cv.contact_tex}
  \vspace{5pt}\VAR{cv.contact_tex}\par
  \BLOCK{endif}
  \BLOCK{if cv.etat_civil}
  \vspace{3pt}{\small
  \BLOCK{for ligne in cv.etat_civil}
  \VAR{ligne[0]} : \VAR{ligne[1]}\BLOCK{if not loop.last} \textbar{}\BLOCK{endif}

  \BLOCK{endfor}
  }\par
  \BLOCK{endif}
\BLOCK{if cv.photo}
\end{minipage}\hfill
\begin{minipage}[c]{0.2\textwidth}\raggedleft
  \includegraphics[width=3cm,height=3.8cm,keepaspectratio]{\VAR{cv.photo}}
\end{minipage}
\BLOCK{else}
\end{center}
\BLOCK{endif}

\BLOCK{if cv.profil}
\section{\VAR{t.profil}}
\VAR{cv.profil}

\BLOCK{endif}
\BLOCK{if cv.experiences}
\section{\VAR{t.experiences}}
\BLOCK{for exp in cv.experiences}
\textbf{\VAR{exp.poste}} \hfill \VAR{exp.dates}\par
\BLOCK{if exp.entreprise or exp.lieu}
\textit{\VAR{[exp.entreprise, exp.lieu]|select|join(", ")}}\par
\BLOCK{endif}
\BLOCK{if exp.points}
\begin{itemize}
  \BLOCK{for point in exp.points}
  \item {}\VAR{point}
  \BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\vspace{4pt}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.formations}
\section{\VAR{t.formations}}
\BLOCK{for f in cv.formations}
\textbf{\VAR{f.diplome}} \hfill \VAR{f.dates}\par
\BLOCK{if f.ecole}
\textit{\VAR{f.ecole}}\par
\BLOCK{endif}
\BLOCK{if f.details}
\VAR{f.details}\par
\BLOCK{endif}
\vspace{4pt}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.competences}
\section{\VAR{t.competences}}
\BLOCK{for c in cv.competences}
\BLOCK{if c.categorie}\textbf{\VAR{c.categorie} :} \BLOCK{endif}\VAR{c.liste}\par
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.langues}
\section{\VAR{t.langues}}
\BLOCK{for l in cv.langues}
\textbf{\VAR{l.langue}}\BLOCK{if l.niveau} : \VAR{l.niveau}\BLOCK{endif}\BLOCK{if not loop.last} \textbar{}\BLOCK{endif}

\BLOCK{endfor}
\par
\BLOCK{endif}

\BLOCK{if cv.certifications}
\section{\VAR{t.certifications}}
\BLOCK{for c in cv.certifications}
\textbf{\VAR{c.titre}}\BLOCK{if c.organisme}, \VAR{c.organisme}\BLOCK{endif} \hfill \VAR{c.date}\par
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.projets}
\section{\VAR{t.projets}}
\BLOCK{for pr in cv.projets}
\textbf{\VAR{pr.titre}} \hfill \VAR{pr.dates}\par
\BLOCK{if pr.details}
\VAR{pr.details}\par
\BLOCK{endif}
\vspace{4pt}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.interets}
\section{\VAR{t.interets}}
\VAR{cv.interets}\par
\BLOCK{endif}

\BLOCK{if cv.references}
\section{\VAR{t.references}}
\BLOCK{for r in cv.references}
\textbf{\VAR{r.nom}}\BLOCK{if r.fonction}, \VAR{r.fonction}\BLOCK{endif}\BLOCK{if r.contact} -- \VAR{r.contact}\BLOCK{endif}\par
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if o.certifier}
\vspace{14pt}
\textit{\VAR{t.certif}}
\BLOCK{endif}

\end{document}
